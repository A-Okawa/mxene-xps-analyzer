{
  "version": "0.1.0",
  "scope": "MAX/MXene XPS request generation, defect/dopant-aware interpretation, quantification, and vendor-vs-Python QC",
  "principles": [
    "Do not infer a unique chemical state from binding energy alone when multiple local environments can produce similar shifts.",
    "Keep composition change, M-site vacancy, X-site vacancy, termination vacancy/disorder, dopant incorporation, oxidation, and secondary phases as separate latent variables.",
    "For mixed-metal MXenes, do not renormalize the metal sublattice to the ideal M count before computing an apparent metal-deficiency index; that would erase the quantity of interest.",
    "Treat XPS-derived vacancy concentration as apparent/surface-sensitive unless independently supported by STEM/EELS/ICP/EDS or another orthogonal method.",
    "Keep raw and model-corrected termination estimates side-by-side; corrections must be explicit and switchable."
  ],
  "structures": {
    "Ti3C2Tx": {
      "m_target": 3.0,
      "x_target": 2.0,
      "default_profile": "ti3c2_brette"
    },
    "Nb2CTx": {
      "m_target": 2.0,
      "x_target": 1.0,
      "default_profile": "nb2c_halim"
    },
    "(Nb,Ti)2CTx": {
      "m_target": 2.0,
      "x_target": 1.0,
      "default_profile": "nbti_m2c_defect_aware"
    }
  },
  "references": {
    "Brette2024": {
      "title": "XPS Binding Energy Shifts in 2D Ti3C2Tz MXene go largely Beyond Intuitive Explanations: Rationalization from DFT Simulations and Experiments",
      "doi": "10.1002/smtd.202400848",
      "use": "DFT-informed Ti3C2Tz BE interpretation; Ti 2p/C 1s/O 1s/F 1s assignments and FWHM examples."
    },
    "Halim2018Vacancy": {
      "title": "Synthesis of Two-Dimensional Nb1.33C (MXene) with Randomly Distributed Vacancies by Etching of the Quaternary Solid Solution (Nb2/3Sc1/3)2AlC MAX Phase",
      "doi": "10.1021/acsanm.8b00332",
      "use": "Nb1.33CTx vacancy-rich reference, Nb2CTx comparison, XPS fit tables, STEM vacancy analysis."
    },
    "Han2020SolidSolution": {
      "title": "Tailoring Electronic and Optical Properties of MXenes through Forming Solid Solutions",
      "doi": "10.1021/jacs.0c07395",
      "use": "Ti-Nb/V solid-solution MXenes, Ti1.2Nb0.8CTx XPS spectra and metal ratios; EDS comparison."
    },
    "Pazniak2021": {
      "title": "Ion Implantation as an Approach for Structural Modifications and Functionalization of Ti3C2Tx MXenes",
      "doi": "10.1021/acsnano.0c06735",
      "use": "Doping plus Ti/C damage; XPS depth profile cross-validated with ToF-SIMS, EDS and EELS."
    },
    "Alonzo2025": {
      "title": "Etching-Chemistry-Driven Ruthenium Doping on Ti3C2Tx MXene for Optimizing Electrochemical Performance",
      "doi": "10.1021/acsnanoscienceau.5c00136",
      "use": "Vacancy-assisted dopant accommodation; XPS plus EPR/EDS; alternative Ti oxidation-state fit model."
    },
    "Liu2025": {
      "title": "Defect passivation and transformation of Ti3C2Tx MXene hollow microsphere for superior electrochemical performance and sodium-ions storage",
      "doi": "10.1016/j.jare.2025.06.003",
      "use": "N/S/V co-doping with lattice/functional substitution and V capture at Ti vacancies; XPS plus DFT."
    },
    "Halim2016": {
      "title": "X-ray photoelectron spectroscopy of select multi-layered transition metal carbides (MXenes)",
      "doi": "10.1016/j.apsusc.2015.11.089",
      "use": "Legacy termination quantification framework for Ti- and Nb-based MXenes."
    }
  },
